{
  "name": "favicon-generator-cli",
  "author": "Andrew Dmitriev <andrew.dmitriev.work@gmail.com>",
  "version": "1.4.0",
  "license": "MIT",
  "description": "A Node.js CLI tool that generates a full set of favicons from PNG and SVG source images. Outputs optimized icons in multiple sizes and formats (ICO, Apple Touch Icon, Android Chrome, etc.) ready for cross-browser use.",
  "keywords": [
    "favicons",
    "favicon generator",
    "cli",
    "image processing",
    "Node.js",
    "tools",
    "utility",
    "icons",
    "ico",
    "apple touch icon",
    "web manifest images"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andmitr/favicon-generator-cli.git"
  },
  "bugs": {
    "url": "https://github.com/andmitr/favicon-generator-cli/issues",
    "email": "andrew.dmitriev.work@gmail.com"
  },
  "funding": {
    "type": "custom",
    "url": "https://andmitr.github.io/donate/"
  },
  "main": "./fn_generate_favicons",
  "exports": "./fn_generate_favicons",
  "type": "module",
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "engines": {
    "node": "24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "bin": {
    "favgen": "fn_generate_favicons"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "globals": "^16.0.0"
  },
  "dependencies": {
    "imagemin": "^9.0.1",
    "imagemin-pngquant": "^10.0.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1"
  }
}
